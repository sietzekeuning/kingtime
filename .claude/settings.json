{
    "permissions": {
        "allow": [
            "Bash(php artisan:*)",
            "Bash(npm run:*)",
            "Bash(npm ci)",
            "Bash(npx vp:*)",
            "Bash(npx vue-tsc:*)",
            "Bash(composer run:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(./vendor/bin/pest:*)",
            "Bash(vendor/bin/phpstan analyse:*)",
            "Bash(php -l:*)",
            "Bash(gh run:*)",
            "mcp__laravel-boost__database-schema",
            "mcp__laravel-boost__database-query",
            "mcp__laravel-boost__list-routes",
            "mcp__laravel-boost__application-info",
            "mcp__laravel-boost__search-docs",
            "mcp__Claude_Browser"
        ],
        "deny": []
    },
    "enabledMcpjsonServers": ["laravel-boost", "herd", "kingtime"],
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/kingtime-guard.sh\"",
                        "timeout": 10,
                        "statusMessage": "Kingtime guard (generated files / copy rules / DDD)"
                    }
                ]
            }
        ]
    }
}
