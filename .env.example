APP_NAME=Kingtime
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Harvest and Moneybird are connected per user under Settings, Integrations.
# Only override the API base URLs here, for example for a proxy.
# HARVEST_BASE_URL=https://api.harvestapp.com/api/v2
# MONEYBIRD_BASE_URL=https://moneybird.com/api/v2

# Keep the sign-up page open after the first user has registered.
KINGTIME_ALLOW_REGISTRATION=false

# Backups (spatie/laravel-backup): daily database + storage/app dump to the `s3` disk.
# Set BACKUP_DISK=local to keep them on the server instead.
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=

# Invoice PDFs are rendered by headless Chrome through Puppeteer (npm). Set
# these when node, npm or the puppeteer module are not where Browsershot
# looks by default (PATH and the project's node_modules).
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_NPM_BINARY=/usr/bin/npm
# BROWSERSHOT_NODE_MODULE_PATH=/home/kingtime/node_modules
# BROWSERSHOT_CHROME_PATH=
